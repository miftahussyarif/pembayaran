# Vercel deployment essentials
DATABASE_URL="postgresql://username:password@host:5432/database"
CRON_SECRET="ganti-dengan-secret-random"

# Optional for file uploads on Vercel Blob (recommended)
BLOB_URL="https://<your-blob-store>.public.blob.vercel-storage.com"
BLOB_READ_WRITE_TOKEN="vercel_blob_token_here"

# Telegram backup features
TELEGRAM_BOT_TOKEN="your_bot_token"
TELEGRAM_CHAT_ID="your_chat_id"

# Optional legacy env names
# VERCEL_BLOB_URL="https://<your-blob-store>.public.blob.vercel-storage.com"
# VERCEL_BLOB_TOKEN="vercel_blob_token_here"
